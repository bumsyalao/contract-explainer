# Copy to .env.local and fill in. Never commit .env.local.
# Keys are server-side only. Never prefix them with NEXT_PUBLIC_.

# Groq (default provider). Free key, no card needed: https://console.groq.com
GROQ_API_KEY=your-groq-key-here

# Groq model names, verified 2026-11-23 (see docs/groq-api-notes.md).
# All three support strict structured output. Names change often: re-check first.
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_COMPARE=qwen/qwen3.8-27b

# Optional: Gemini adapter, only if you have a Google AI Studio key.
# Verified 2026-11-21 (see docs/gemini-api-notes.md). Leave blank to skip.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_COMPARE_MODEL=gemini-4-hydrogen

# Public demo switch. Set to off to serve only the saved sample: no uploads, no live
# questions, no model calls, so the free quota cannot be used up by visitors.
LIVE_ANALYSIS=on
