# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key (server-side only, never prefix with NEXT_PUBLIC_)
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Model names live here so they can be swapped without code changes.
# Verified against the Gemini docs on 2026-11-21 (see docs/gemini-api-notes.md).
# Model names change often: re-check the models page before editing.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_COMPARE_MODEL=gemini-4-hydrogen

# Local mode (Ollama), for real documents that must not leave your machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
