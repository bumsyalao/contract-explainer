# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key (server-side only, never prefix with NEXT_PUBLIC_)
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Model names are set here so they can be swapped without code changes.
# Look up current names in the Google AI docs before filling these in.
GEMINI_MODEL=
GEMINI_LITE_MODEL=

# Local mode (Ollama), for real documents that must not leave your machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
